{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fishbone.schema.json",
  "title": "项目鱼骨图数据 v1",
  "description": "一份数据对应一个项目的一张鱼骨图：鱼尾是开始日期，鱼头是结束日期和目标，骨头是里程碑，主干上的亮点是进展。允许增加自定义字段。",
  "type": "object",
  "required": ["version", "project", "milestones", "updates"],
  "properties": {
    "version": { "const": 1, "description": "数据结构版本号" },
    "project": { "$ref": "#/$defs/project" },
    "milestones": {
      "type": "array",
      "description": "骨头：里程碑",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "updates": {
      "type": "array",
      "description": "亮点：进展记录",
      "items": { "$ref": "#/$defs/update" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "日期，格式 YYYY-MM-DD"
    },
    "attachment": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "description": "附件名称" },
        "url": { "type": "string", "description": "文档链接，例如飞书 / 语雀地址" },
        "type": {
          "enum": ["doc", "sheet", "slide", "design", "link", "file"],
          "default": "doc",
          "description": "doc 文档 | sheet 表格 | slide 演示 | design 设计稿 | link 链接 | file 文件"
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "start", "end"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "项目唯一标识" },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "description": "项目负责人" },
        "members": { "type": "array", "items": { "type": "string" } },
        "start": { "$ref": "#/$defs/date", "description": "鱼尾：项目开始日期" },
        "end": { "$ref": "#/$defs/date", "description": "鱼头：项目结束日期，需晚于 start" },
        "status": {
          "enum": ["on_track", "at_risk", "delayed", "done"],
          "default": "on_track",
          "description": "on_track 正常 | at_risk 有风险 | delayed 已延期 | done 已完成"
        },
        "goal": {
          "type": "object",
          "required": ["title"],
          "description": "鱼头上显示的最终目标",
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string" }
          }
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["id", "title", "planned_date", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "description": "写在骨头卡片上的名称" },
        "planned_date": { "$ref": "#/$defs/date", "description": "计划日期；未完成的骨头画在这里" },
        "done_date": {
          "anyOf": [{ "$ref": "#/$defs/date" }, { "const": "" }],
          "description": "实际完成日期；status 为 done 时骨头画在这里"
        },
        "status": {
          "enum": ["planned", "in_progress", "done", "delayed"],
          "description": "planned 计划中 | in_progress 进行中 | done 已完成 | delayed 已延期"
        },
        "owner": { "type": "string" },
        "summary": { "type": "string", "description": "说明或完成情况" },
        "side": {
          "enum": ["auto", "up", "down"],
          "default": "auto",
          "description": "骨头朝向：auto 上下交替 | up 朝上 | down 朝下"
        },
        "attachments": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/attachment" }
        }
      }
    },
    "update": {
      "type": "object",
      "required": ["id", "date", "title"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" },
        "author": { "type": "string", "description": "填写人" },
        "title": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "description": "进展内容" },
        "status": {
          "enum": ["normal", "risk", "blocked"],
          "default": "normal",
          "description": "normal 正常 | risk 有风险 | blocked 受阻，决定亮点颜色"
        },
        "risk": { "type": "string", "description": "风险或需要的支持" },
        "attachments": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/$defs/attachment" }
        }
      }
    }
  }
}
